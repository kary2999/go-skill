// 本文件是模板。复制为 defaults_local.go（同目录），填入你的内部默认值，再构建。
//
// 防 git 泄漏：
//   - defaults_local.go 已在 .gitignore，不会被 commit
//   - 只有 defaults_local.go.example（空模板）进 git
//   - 团队不同分支 / 不同人填不同 key 互不干扰
//
// 用法：
//   1. cp defaults_local.go.example defaults_local.go
//   2. 把 DefaultClawnovaKey 改成真实 key
//   3. bash build-mac-app.sh
//
// 安全提醒：
//   - 真实 key 会编进二进制，DMG 接收方能 `strings` 出来
//   - 仅限**内部分发**场景使用，不要把含 key 的 DMG 上传到公网
//   - key 一旦泄露要立刻在 IDP 平台 revoke，重发后改这里再重新打包

package main

const (
	// 默认 Clawnova API Base —— 公网可见的 endpoint，无敏感信息，可以入 git
	DefaultClawnovaAPIBase = "https://clawnova.ai/api/v1"

	// 默认 Clawnova Key —— ⚠️ 敏感信息，**禁止** commit。空字符串则不预填，用户自己粘。
	DefaultClawnovaKey = ""

	// 默认模型
	DefaultClawnovaModel = "qwen3.5-27b-local"
)
